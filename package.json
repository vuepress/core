{
  "name": "@vuepress/monorepo",
  "version": "2.0.0-rc.31",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --stream build",
    "check-types": "node scripts/vue-tsc.cjs --noEmit",
    "clean": "pnpm run --parallel --stream clean",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm release:version",
    "release:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:check": "pnpm clean && pnpm build && pnpm check-types && pnpm lint && pnpm test",
    "release:version": "bumpp -r --execute=\"pnpm release:changelog\" --commit \"build: publish v%s\" --all",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm --filter e2e e2e:dev && pnpm --filter e2e e2e:build",
    "test:e2e:webpack": "pnpm --filter e2e e2e:dev:webpack && pnpm --filter e2e e2e:build:webpack",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "@types/webpack-env": "^1.18.8",
    "@vitest/coverage-istanbul": "catalog:vite",
    "@vuepress/oxfmt-config": "^8.3.0",
    "@vuepress/oxlint-config": "^8.3.0",
    "@vuepress/tsconfig": "^8.2.1",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "taze": "^21.3.0",
    "tsdown": "catalog:vite",
    "typescript": "^7.0.2",
    "typescript-native-bridge": "6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "catalog:vite",
    "vitest": "catalog:vite",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.!(cjs|js|ts|vue)": "oxfmt --no-error-on-unmatched-pattern",
    "*.(cjs|js|ts|vue)": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    }
  }
}
